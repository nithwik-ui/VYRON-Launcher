# VYRON Backend Environment Configuration (Template)
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL

# Server
APP_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Database (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres:USER_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
DIRECT_URL=postgresql://postgres:USER_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# Supabase Infrastructure
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder
SUPABASE_SECRET_KEY=sb_secret_placeholder

# Redis Cache & Ephemeral State
REDIS_URL=redis://localhost:6379

# Security & CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
